PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_NAME=helmi_travel
DB_USER=root
DB_PASSWORD=
DATABASE_URL=
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_SSL_CA=
DB_POOL_MAX=10
JWT_SECRET=change_this_secret_in_production
JWT_REFRESH_SECRET=change_this_refresh_secret_in_production
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
UPLOAD_DIR=
# Activer uniquement derrière un reverse proxy maîtrisé (Render, Railway, Nginx...)
TRUST_PROXY=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Helmi Travel <no-reply@helmitravel.tn>"
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MODE=sandbox
# Stripe et PayPal n'acceptent pas toujours TND. Le taux convertit 1 TND vers cette devise.
PAYMENT_CURRENCY=EUR
PAYMENT_EXCHANGE_RATE=
# SMS optionnel via une passerelle HTTP compatible JSON
SMS_PROVIDER=disabled
SMS_API_URL=
SMS_API_TOKEN=
SMS_SENDER=HELMI
